---
import Layout from '../layouts/Layout.astro';
import FacilityIcon from '../components/FacilityIcon.astro';
import '../styles/cfa.css';
import { inclusionStatements } from '../data/cfa';
import { getBusinessHours, getFacilities, getServices, getSiteSettings, getTestimonials } from '../lib/content';
const [settings, hours, services, testimonials, facilities] = await Promise.all([getSiteSettings(), getBusinessHours(), getServices(), getTestimonials(), getFacilities()]);
---
<Layout title="CFA Pilates e Fisioterapia Barretos" description="CFA Pilates e Fisioterapia Barretos: Pilates, Fisioterapia, aulas on-line e serviços no local." settings={settings}>
  <main id="conteudo">
    <section class="hero" id="inicio"><div class="container hero-grid"><div><p class="eyebrow">Barretos – SP</p><h1>CFA Pilates e Fisioterapia <span>Barretos</span></h1><p class="hero-copy">Pilates e Fisioterapia com um ambiente acolhedor.</p><div class="hero-actions"><a class="button" href={settings.whatsappUrl} target="_blank" rel="noopener noreferrer">Agendar pelo WhatsApp</a><a class="text-link" href="#contato">Ver contato e horários <span aria-hidden="true">↓</span></a></div></div><div class="hero-mark" aria-hidden="true"><div class="hero-orbit"></div><img src={settings.logo} width="150" height="150" alt="" /></div></div></section>

    <section class="section services" id="servicos"><div class="container"><p class="eyebrow">Atendimentos</p><h2>O que você encontra na CFA</h2><div class="service-grid">{services.map((service) => <article class="service-card" id={service.title === 'Pilates' ? 'pilates' : service.title === 'Fisioterapia' ? 'fisioterapia' : undefined}><span class="service-number">0{service.order}</span><h3>{service.title}</h3><p>{service.description}</p></article>)}</div></div></section>

    <section class="section structure" id="estrutura"><div class="container"><p class="eyebrow">Estrutura e comodidades</p><h2>Informações para a sua visita</h2><div class="facility-grid">{facilities.map((facility) => <article class="facility-card"><span class="facility-icon"><FacilityIcon name={facility.icon} /></span><h3>{facility.title}</h3><p>{facility.description}</p></article>)}</div></div></section>

    <section class="inclusion"><div class="container inclusion-inner"><div><p class="eyebrow">Inclusão</p><h2>Um espaço de acolhimento</h2></div><ul>{inclusionStatements.map((statement) => <li>{statement}</li>)}</ul></div></section>

    <section class="section testimonials" id="depoimentos"><div class="container"><p class="eyebrow">Experiência</p><h2>Depoimentos de clientes</h2>{testimonials.length ? <div class="testimonial-grid">{testimonials.map((testimonial) => <article class="testimonial-card"><p class="testimonial-label">Depoimento de cliente</p><blockquote>“{testimonial.text}”</blockquote><p>— {testimonial.name}</p>{testimonial.date && <time datetime={testimonial.date}>{testimonial.date.split('-').reverse().join('/')}</time>}</article>)}</div> : <p class="empty-state">Os depoimentos de clientes serão apresentados aqui quando forem disponibilizados pela CFA.</p>}</div></section>

    <section class="section contact" id="contato"><div class="container contact-grid"><div class="contact-intro"><p class="eyebrow">Contato e agendamento</p><h2>Vamos conversar?</h2><p>Para agendar, fale com a CFA pelo WhatsApp.</p><a class="button" href={settings.whatsappUrl} target="_blank" rel="noopener noreferrer">Agendar pelo WhatsApp</a></div><div class="contact-details"><div><h3>Endereço</h3><address>{settings.address.street}<br />{settings.address.neighborhood}, {settings.address.city} – {settings.address.state}<br />CEP {settings.address.postalCode}<br /><span>{settings.plusCode}</span></address><a class="text-link" href={settings.mapUrl} target="_blank" rel="noopener noreferrer">Ver localização <span aria-hidden="true">↗</span></a></div><div><h3>Telefone e redes</h3><a href={settings.phoneHref}>{settings.phone}</a><a href={settings.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a><a href={settings.instagramUrl} target="_blank" rel="noopener noreferrer">Conhecer o Instagram</a></div></div><div class="hours"><h3>Horários</h3><dl>{hours.map((hour) => <div><dt>{hour.day}</dt><dd>{hour.open ? `${hour.opensAt}–${hour.closesAt}` : 'Fechado'}</dd></div>)}</dl></div></div></section>
  </main>
</Layout>
<style>.hero{background:linear-gradient(135deg,#f4f8f3 0%,#fffefb 60%,#f8eee7 100%);overflow:hidden;padding:clamp(4.5rem,10vw,8.5rem) 0}.hero-grid{align-items:center;display:grid;gap:2.5rem;grid-template-columns:1.3fr .7fr}.hero h1{font-size:clamp(2.8rem,6vw,5.25rem);margin-bottom:1.25rem;max-width:13ch}.hero h1 span{color:var(--brand)}.hero-copy{color:var(--muted);font-size:clamp(1.15rem,2vw,1.4rem);max-width:34rem}.hero-actions{align-items:center;display:flex;flex-wrap:wrap;gap:1.1rem;margin-top:2rem}.text-link{color:var(--brand-deep);font-weight:750;text-decoration-thickness:1px;text-underline-offset:4px}.hero-mark{align-items:center;aspect-ratio:1;display:flex;justify-content:center;position:relative}.hero-mark img{border-radius:50%;box-shadow:var(--shadow);height:auto;position:relative;width:min(100%,15rem)}.hero-orbit{border:1px solid var(--brand);border-radius:50%;height:92%;opacity:.25;position:absolute;width:92%}.section{padding:clamp(4rem,8vw,6.5rem) 0}.section h2{max-width:17ch}.service-grid,.facility-grid{display:grid;gap:1rem;margin-top:2rem}.service-grid{grid-template-columns:repeat(4,1fr)}.service-card,.facility-card{border:1px solid var(--line);border-radius:var(--radius);padding:1.5rem}.service-card{background:#fff;min-height:14rem}.service-number{color:var(--accent);font-size:.85rem;font-weight:800}.service-card h3,.facility-card h3{font-size:1.25rem;margin:1.1rem 0 .55rem}.service-card p,.facility-card p{color:var(--muted);margin-bottom:0}.structure{background:var(--wash)}.facility-grid{grid-template-columns:repeat(4,1fr)}.facility-card{background:var(--paper)}.facility-icon{align-items:center;background:#e0eee6;border-radius:50%;color:var(--brand-deep);display:inline-flex;font-size:1.2rem;font-weight:800;height:2.6rem;justify-content:center;width:2.6rem}.inclusion{background:var(--brand-deep);color:#f8fbf8;padding:3rem 0}.inclusion .eyebrow{color:#b7d5c7}.inclusion h2{margin-bottom:0}.inclusion-inner{align-items:center;display:grid;gap:2rem;grid-template-columns:1fr 1.4fr}.inclusion ul{display:grid;gap:.75rem;list-style:none;margin:0;padding:0}.inclusion li{border-left:2px solid var(--accent);padding-left:1rem}.testimonials{background:#fcf7f2}.empty-state{color:var(--muted);max-width:41rem}.testimonial-grid{display:grid;gap:1rem;margin-top:2rem}.testimonial-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:1.5rem}.testimonial-label{color:var(--brand-deep);font-size:.8rem;font-weight:800;text-transform:uppercase}.testimonial-card blockquote{font-size:1.1rem;margin:1rem 0}.contact{background:var(--wash)}.contact-grid{display:grid;gap:2rem;grid-template-columns:1.15fr 1fr .75fr}.contact-intro>p:not(.eyebrow){color:var(--muted);font-size:1.1rem;max-width:24rem}.contact-intro .button{margin-top:1rem}.contact-details{display:grid;gap:1.75rem}.contact h3{font-size:1.05rem;margin-bottom:.6rem}.contact-details address,.contact-details a{color:var(--muted);display:block;font-style:normal;margin-bottom:.45rem}.contact-details .text-link{color:var(--brand-deep);margin-top:.8rem}.hours{border-left:1px solid var(--line);padding-left:1.5rem}.hours dl{margin:0}.hours dl div{display:flex;justify-content:space-between;padding:.35rem 0}.hours dd{color:var(--muted);margin:0}@media(max-width:900px){.service-grid,.facility-grid{grid-template-columns:repeat(2,1fr)}.contact-grid{grid-template-columns:1fr 1fr}.contact-intro{grid-column:1/-1}}@media(max-width:650px){.hero-grid,.inclusion-inner,.contact-grid{grid-template-columns:1fr}.hero-mark{display:none}.service-grid,.facility-grid{grid-template-columns:1fr}.service-card{min-height:auto}.hours{border-left:0;border-top:1px solid var(--line);padding-left:0;padding-top:1.5rem}}</style>
