---
import type { SiteSettings } from '../types/content'; interface Props { settings: SiteSettings } const { settings } = Astro.props;
---
<footer><div class="container footer-grid"><div><a class="brand" href="#inicio"><img src={settings.logo} width="72" height="72" alt="CFA Pilates e Fisioterapia" /></a><p>{settings.name}</p></div><address><strong>Endereço</strong><span>{settings.address.street}</span><span>{settings.address.neighborhood}, {settings.address.city} - {settings.address.state}</span><span>CEP {settings.address.postalCode}</span></address><div><strong>Contato</strong><a href={settings.phoneHref}>{settings.phone}</a><a href={settings.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a><a href={settings.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a></div><div><strong>Horários</strong><span>Seg–Qui: 07:00–20:00</span><span>Sex: 07:00–11:00</span><span>Sáb e Dom: fechado</span></div></div><div class="container copyright">© {new Date().getFullYear()} CFA Pilates e Fisioterapia Barretos.</div></footer>
<style>footer{background:#183d38;color:#eaf2ed;padding:3.5rem 0 1.25rem}.brand img{height:4rem;width:4rem;object-fit:contain}.footer-grid{display:grid;gap:2rem;grid-template-columns:1.35fr 1fr 1fr 1fr}.footer-grid p{color:#c0d2ca;margin:.8rem 0 0}.footer-grid address,.footer-grid div:not(:first-child){display:flex;flex-direction:column;font-style:normal;gap:.3rem}.footer-grid strong{color:#fff;font-size:.9rem;margin-bottom:.35rem}.footer-grid a,.footer-grid span{color:#c0d2ca;text-decoration:none}.footer-grid a:hover{color:#fff;text-decoration:underline}.copyright{border-top:1px solid rgba(255,255,255,.16);color:#b9d2c7;font-size:.85rem;margin-top:2.8rem;padding-top:1.2rem}@media(max-width:760px){.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}}@media(max-width:420px){.footer-grid{grid-template-columns:1fr}}</style>
