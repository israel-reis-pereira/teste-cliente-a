---
import type { Facility } from '../types/content';

interface Props {
  name: Facility['icon'];
}

const { name } = Astro.props;
---

{name === 'accessibility' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <circle cx="12" cy="4.5" r="2" />
    <path d="M10.5 9h3l1.5 4.5h3" />
    <path d="M12 9v5l-3.5 5" />
    <path d="M12 14l3.5 5" />
    <path d="M8.5 11.5a6.5 6.5 0 1 0 7.1 8" />
  </svg>
)}

{name === 'amenities' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M5 11V7a5 5 0 0 1 10 0v1" />
    <path d="M5 11h12a2 2 0 0 1 2 2v1H5z" />
    <path d="M7 16v2M17 16v2M8 20h8" />
    <path d="M18 4v1M21 6v1M15 4v1" />
  </svg>
)}

{name === 'parking' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M5 15l1.5-5h11L19 15" />
    <path d="M4 15h16v4H4z" />
    <path d="M7 19v1M17 19v1" />
    <circle cx="7" cy="15.5" r=".75" fill="currentColor" stroke="none" />
    <circle cx="17" cy="15.5" r=".75" fill="currentColor" stroke="none" />
  </svg>
)}

{name === 'payment' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="M3 10h18M7 15h3" />
  </svg>
)}
