---
import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import type { SiteSettings } from '../types/content';
interface Props { title: string; description: string; settings: SiteSettings }
const { title, description, settings } = Astro.props; const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin; const canonical = new URL(Astro.url.pathname, siteUrl).href;
const schema = {'@context':'https://schema.org','@type':'LocalBusiness',name:settings.name,url:siteUrl,logo:new URL(settings.logo,siteUrl).href,telephone:settings.phone,address:{'@type':'PostalAddress',streetAddress:settings.address.street,addressLocality:settings.address.city,addressRegion:settings.address.state,postalCode:settings.address.postalCode,addressCountry:'BR'},sameAs:[settings.instagramUrl],openingHoursSpecification:[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday'],opens:'07:00',closes:'20:00'},{'@type':'OpeningHoursSpecification',dayOfWeek:'Friday',opens:'07:00',closes:'11:00'}]};
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><link rel="icon" type="image/png" href={settings.logo} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(settings.logo,siteUrl).href} /><meta property="og:locale" content="pt_BR" /><meta property="og:site_name" content={settings.name} /><meta name="twitter:card" content="summary" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={new URL(settings.logo,siteUrl).href} /><script type="application/ld+json" set:html={JSON.stringify(schema)} /></head><body><a class="skip-link" href="#conteudo">Pular para o conteúdo principal</a><Header settings={settings} /><slot /><Footer settings={settings} /></body></html>
<style is:global>:root{--brand:#2c756b;--brand-deep:#19574f;--accent:#c98053;--paper:#fffefb;--wash:#edf4ef;--ink:#1d2a28;--muted:#566560;--line:#d4e1da;--focus:#135db2;--radius:1.15rem;--shadow:0 14px 38px rgba(25,55,48,.1);--container:72rem;--gutter:1.25rem}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:16px;line-height:1.55}a,button{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible{outline:3px solid var(--focus);outline-offset:3px}.container{width:min(var(--container),calc(100% - (var(--gutter)*2)));margin-inline:auto}.skip-link{background:var(--ink);color:#fff;left:1rem;padding:.7rem 1rem;position:fixed;top:-5rem;z-index:100}.skip-link:focus{top:1rem}.button{align-items:center;background:var(--brand);border:1px solid var(--brand);border-radius:999px;color:#fff;display:inline-flex;font-weight:750;justify-content:center;min-height:3rem;padding:.68rem 1.15rem;text-decoration:none;transition:transform .2s ease,background-color .2s ease}.button:hover{background:var(--brand-deep);transform:translateY(-2px)}.button--outline{background:transparent;color:var(--brand-deep)}.button--outline:hover{background:var(--wash)}.eyebrow{color:var(--brand-deep);font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}h1,h2,h3,p{margin-top:0}h1,h2,h3{letter-spacing:-.045em;line-height:1.08}h2{font-size:clamp(1.9rem,4vw,3rem)}section{scroll-margin-top:6rem}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important}}</style>
